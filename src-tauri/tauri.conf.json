{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "霧宿啟動器",
  "version": "0.1.2",
  "identifier": "life.shizune.mistinn.launcher",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "霧宿啟動器",
        "width": 1080,
        "height": 640,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "copyright": "森之宿茶室 MoriTeahouse",
    "shortDescription": "霧宿：追放的啟動器"
  }
}
